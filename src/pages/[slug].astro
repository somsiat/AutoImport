---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import ContactForm from '~/components/ContactForm.astro';
import Faq from '~/components/Faq.astro';
import { landings, type Landing } from '~/data/landings';
import { faq } from '~/data/content';
import { faqSchema, serviceSchema } from '~/lib/schema';

export function getStaticPaths() {
  return landings.map((landing) => ({
    params: { slug: landing.slug },
    props: { landing },
  }));
}

interface Props {
  landing: Landing;
}

const { landing } = Astro.props;
const path = `/${landing.slug}`;
const landingFaq = faq.slice(0, 3);
---

<BaseLayout
  title={landing.title}
  description={landing.description}
  breadcrumbs={[{ name: landing.h1, href: path }]}
  schemas={[
    serviceSchema({ name: landing.h1, description: landing.description, path }),
    faqSchema(landingFaq),
  ]}
>
  <PageHero title={landing.h1} lead={landing.lead}>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="#formularz"
        class="rounded-xl bg-accent-500 px-7 py-4 text-center font-bold text-ink-900 hover:bg-accent-400"
      >
        Zapytaj o wycenę
      </a>
      <a
        href="/realizacje"
        class="rounded-xl border border-white/20 px-7 py-4 text-center font-bold text-white hover:bg-white/10"
      >
        Zobacz realizacje
      </a>
    </div>
  </PageHero>

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-3xl space-y-12 px-4 sm:px-6 lg:px-8">
      {
        landing.sections.map((section) => (
          <div>
            <h2 class="text-3xl font-extrabold tracking-tight text-ink-900">{section.heading}</h2>
            {section.body.map((paragraph) => (
              <p class="mt-4 text-lg leading-relaxed text-ink-700">{paragraph}</p>
            ))}
          </div>
        ))
      }

      {
        landing.bullets && (
          <div class="rounded-2xl bg-ink-50 p-8">
            <h2 class="text-2xl font-extrabold tracking-tight text-ink-900">
              {landing.bullets.heading}
            </h2>
            <ul class="mt-6 space-y-3">
              {landing.bullets.items.map((item) => (
                <li class="flex gap-3">
                  <svg
                    class="mt-1 h-5 w-5 shrink-0 text-accent-600"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    aria-hidden="true"
                  >
                    <path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="text-ink-700">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <Faq items={landingFaq} title="Najczęstsze pytania" />

  <section class="bg-ink-50 py-16 sm:py-24" id="formularz">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-ink-900">Wyceń swoje auto</h2>
      <p class="mt-3 text-ink-500">
        Odpowiadamy w ciągu 2 godzin roboczych. Bez zaliczki na tym etapie.
      </p>
      <div class="mt-8">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
