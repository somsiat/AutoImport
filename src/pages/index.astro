---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Faq from '~/components/Faq.astro';
import CtaBanner from '~/components/CtaBanner.astro';
import { contact } from '~/config/site';
import { steps, benefits, faq, projects, stats, testimonials } from '~/data/content';
import { faqSchema, serviceSchema } from '~/lib/schema';

const title = 'Import samochodów z USA — Copart i IAAI';
const description =
  'Sprowadzamy auta z USA i Kanady pod klucz: licytacja, transport, cło, akcyza i naprawa w jednej cenie ustalonej przed zakupem. 850+ sprowadzonych aut.';
---

<BaseLayout
  title={title}
  description={description}
  schemas={[
    faqSchema(faq),
    serviceSchema({
      name: 'Import samochodów z USA i Kanady',
      description,
      path: '/',
    }),
  ]}
>
  <section class="relative overflow-hidden bg-ink-900">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(247,183,51,0.18),transparent_55%)]"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 sm:py-28 lg:px-8">
      <div class="max-w-3xl">
        <p
          class="inline-flex items-center gap-2 rounded-full border border-accent-500/30 bg-accent-500/10 px-4 py-1.5 text-sm font-semibold text-accent-400"
        >
          Copart · IAAI · Manheim — licytujemy na własnych kontach
        </p>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.1] tracking-tight text-white sm:text-6xl">
          Import samochodów z USA
          <span class="block text-accent-400">bez ukrytych kosztów</span>
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-ink-300 sm:text-xl">
          Cenę „pod klucz” — auto, transport, cło, akcyzę i naprawę — ustalamy
          <strong class="text-white">przed licytacją</strong> i się jej trzymamy. Ty decydujesz o
          limicie, my zajmujemy się resztą.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="/kontakt"
            class="rounded-xl bg-accent-500 px-7 py-4 text-center text-base font-bold text-ink-900 transition-colors hover:bg-accent-400"
          >
            Darmowa wycena auta
          </a>
          <a
            href={contact.whatsappGroup}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="rounded-xl border border-white/20 px-7 py-4 text-center text-base font-bold text-white transition-colors hover:bg-white/10"
          >
            Dołącz do grupy WhatsApp z ofertami
          </a>
        </div>

        <dl class="mt-14 grid grid-cols-2 gap-6 border-t border-white/10 pt-8 lg:grid-cols-4">
          {
            stats.map((stat) => (
              <div>
                <dt class="sr-only">{stat.label}</dt>
                <dd>
                  <span class="block text-3xl font-extrabold text-accent-400">{stat.value}</span>
                  <span class="mt-1 block text-sm text-ink-300">{stat.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          Dlaczego klienci sprowadzają auta z nami
        </h2>
        <p class="mt-4 text-lg text-ink-500">
          Import z USA opłaca się tylko wtedy, gdy wszystkie koszty są policzone od początku.
          Dlatego pracujemy na stałej cenie i pokazujemy każdy etap.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          benefits.map((benefit) => (
            <div class="rounded-2xl border border-ink-100 p-6 transition-shadow hover:shadow-lg">
              <h3 class="text-lg font-bold text-ink-900">{benefit.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-500">{benefit.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-ink-50 py-16 sm:py-24" id="proces">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
          Jak wygląda sprowadzenie auta — krok po kroku
        </h2>
        <p class="mt-4 text-lg text-ink-500">
          Cały proces zajmuje zwykle 8–12 tygodni. Na każdym etapie dostajesz zdjęcia i status na
          WhatsAppie.
        </p>
      </div>

      <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          steps.map((step, i) => (
            <li class="rounded-2xl bg-white p-6 shadow-sm">
              <span
                class="grid h-10 w-10 place-items-center rounded-lg bg-ink-900 font-extrabold text-accent-400"
              >
                {i + 1}
              </span>
              <h3 class="mt-4 text-lg font-bold text-ink-900">{step.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <a
        href="/jak-to-dziala"
        class="mt-10 inline-flex font-semibold text-accent-600 underline hover:text-accent-500"
      >
        Zobacz szczegółowy opis procesu i wymagane dokumenty
      </a>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <h2 class="text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
            Ostatnio sprowadzone auta
          </h2>
          <p class="mt-4 text-lg text-ink-500">
            Prawdziwe rozliczenia: cena z aukcji, koszt końcowy w Polsce i porównanie z rynkiem
            krajowym.
          </p>
        </div>
        <a href="/realizacje" class="font-semibold text-accent-600 underline hover:text-accent-500">
          Wszystkie realizacje
        </a>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          projects.slice(0, 3).map((project) => (
            <article class="flex flex-col overflow-hidden rounded-2xl border border-ink-100">
              <div class="grid aspect-[16/10] place-items-center bg-ink-100 text-sm text-ink-500">
                {/* TODO(klient): podmienic na zdjecie auta (astro:assets, WebP). */}
                Zdjęcie: {project.title}
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-lg font-bold text-ink-900">
                  {project.title} <span class="text-ink-500">({project.year})</span>
                </h3>
                <dl class="mt-4 space-y-2 text-sm">
                  <div class="flex justify-between gap-4">
                    <dt class="text-ink-500">Aukcja</dt>
                    <dd class="text-right font-medium">{project.auction}</dd>
                  </div>
                  <div class="flex justify-between gap-4">
                    <dt class="text-ink-500">Uszkodzenia</dt>
                    <dd class="text-right font-medium">{project.damage}</dd>
                  </div>
                  <div class="flex justify-between gap-4">
                    <dt class="text-ink-500">Koszt końcowy</dt>
                    <dd class="text-right font-extrabold text-ink-900">{project.totalPl}</dd>
                  </div>
                  <div class="flex justify-between gap-4">
                    <dt class="text-ink-500">Rynek PL</dt>
                    <dd class="text-right font-medium text-accent-600 line-through">
                      {project.marketPl}
                    </dd>
                  </div>
                </dl>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-ink-50 py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Co mówią klienci
      </h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          testimonials.map((t) => (
            <figure class="flex flex-col rounded-2xl bg-white p-6 shadow-sm">
              <blockquote class="flex-1 leading-relaxed text-ink-700">„{t.text}”</blockquote>
              <figcaption class="mt-5 border-t border-ink-100 pt-4 text-sm">
                <span class="font-bold text-ink-900">{t.name}</span>
                <span class="text-ink-500">, {t.city} — {t.car}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <Faq
    items={faq}
    intro="Zebraliśmy pytania, które słyszymy najczęściej. Jeśli czegoś brakuje — napisz na WhatsAppie, odpowiadamy tego samego dnia."
  />

  <CtaBanner />
</BaseLayout>
