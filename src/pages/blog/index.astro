---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import CtaBanner from '~/components/CtaBanner.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const dateFormat = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'long' });
---

<BaseLayout
  title="Blog o imporcie samochodów z USA"
  description="Poradniki o sprowadzaniu aut z USA: koszty i podatki, czytanie aukcji Copart i IAAI, formalności celne oraz rejestracja w Polsce."
  breadcrumbs={[{ name: 'Blog', href: '/blog' }]}
>
  <PageHero
    eyebrow="Blog"
    title="Wiedza o imporcie aut z USA"
    lead="Piszemy o tym, o co pytają nas klienci: ile realnie kosztuje import, jak czytać opisy aukcyjne i jak przejść formalności bez drugiej wizyty w urzędzie."
  />

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <ul class="divide-y divide-ink-100">
        {
          posts.map((post) => (
            <li class="py-8 first:pt-0">
              <article>
                <div class="flex flex-wrap items-center gap-3 text-sm">
                  <span
                    class="rounded-full bg-accent-500/15 px-3 py-1 font-semibold text-accent-600"
                  >
                    {post.data.category}
                  </span>
                  <time datetime={post.data.publishedAt.toISOString()} class="text-ink-500">
                    {dateFormat.format(post.data.publishedAt)}
                  </time>
                </div>
                <h2 class="mt-3 text-2xl font-extrabold tracking-tight text-ink-900">
                  <a href={`/blog/${post.id}`} class="hover:text-accent-600">{post.data.title}</a>
                </h2>
                <p class="mt-2 leading-relaxed text-ink-500">{post.data.description}</p>
                <a
                  href={`/blog/${post.id}`}
                  class="mt-4 inline-flex font-semibold text-accent-600 hover:text-accent-500"
                >
                  Czytaj dalej →
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
