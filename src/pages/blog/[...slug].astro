---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import CtaBanner from '~/components/CtaBanner.astro';
import { articleSchema } from '~/lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat('pl-PL', { dateStyle: 'long' });
const path = `/blog/${post.id}`;

const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((entry) => entry.id !== post.id)
  .slice(0, 2);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  breadcrumbs={[
    { name: 'Blog', href: '/blog' },
    { name: post.data.title, href: path },
  ]}
  schemas={[
    articleSchema({
      title: post.data.title,
      description: post.data.description,
      path,
      image: post.data.image,
      publishedAt: post.data.publishedAt,
      updatedAt: post.data.updatedAt,
      author: post.data.author,
    }),
  ]}
>
  <article class="bg-white">
    <header class="bg-ink-900 py-14 sm:py-20">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-center gap-3 text-sm">
          <span class="rounded-full bg-accent-500/20 px-3 py-1 font-semibold text-accent-400">
            {post.data.category}
          </span>
          <time datetime={post.data.publishedAt.toISOString()} class="text-ink-300">
            {dateFormat.format(post.data.publishedAt)}
          </time>
          {
            post.data.updatedAt && (
              <span class="text-ink-500">
                (aktualizacja: {dateFormat.format(post.data.updatedAt)})
              </span>
            )
          }
        </div>
        <h1 class="mt-4 text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl">
          {post.data.title}
        </h1>
        <p class="mt-4 text-lg text-ink-300">{post.data.description}</p>
        <p class="mt-6 text-sm text-ink-500">{post.data.author}</p>
      </div>
    </header>

    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
      <div class="post-body">
        <Content />
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="border-t border-ink-100 bg-ink-50 py-14">
        <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl font-extrabold tracking-tight text-ink-900">Przeczytaj też</h2>
          <ul class="mt-6 space-y-4">
            {related.map((entry) => (
              <li class="rounded-xl bg-white p-5 shadow-sm">
                <a href={`/blog/${entry.id}`} class="font-bold text-ink-900 hover:text-accent-600">
                  {entry.data.title}
                </a>
                <p class="mt-1 text-sm text-ink-500">{entry.data.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBanner />
</BaseLayout>

<style>
  /* Styl tresci z Markdown - zamiast wtyczki typography, zeby nie dociagac zaleznosci. */
  .post-body {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-700);
  }

  .post-body :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.625rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-ink-900);
  }

  .post-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-ink-900);
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: 1.25rem;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: 1.5rem;
  }

  .post-body :global(ul) {
    list-style: disc;
  }

  .post-body :global(ol) {
    list-style: decimal;
  }

  .post-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-body :global(strong) {
    font-weight: 700;
    color: var(--color-ink-900);
  }

  .post-body :global(a) {
    font-weight: 600;
    color: var(--color-accent-600);
    text-decoration: underline;
  }

  .post-body :global(table) {
    width: 100%;
    margin-bottom: 1.5rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .post-body :global(th),
  .post-body :global(td) {
    border-bottom: 1px solid var(--color-ink-100);
    padding: 0.625rem 0.5rem;
    text-align: left;
  }

  .post-body :global(th) {
    font-weight: 700;
    color: var(--color-ink-900);
  }

  .post-body :global(blockquote) {
    margin: 1.5rem 0;
    border-left: 4px solid var(--color-accent-500);
    padding-left: 1rem;
    font-style: italic;
  }
</style>
