---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import ContactForm from '~/components/ContactForm.astro';
import { contact, address, social, site } from '~/config/site';
---

<BaseLayout
  title="Kontakt — wyceń import auta z USA"
  description={`Napisz lub zadzwoń: ${contact.phone}. Bezpłatna wycena importu samochodu z USA w ciągu 2 godzin roboczych. Biuro: ${address.city}.`}
  breadcrumbs={[{ name: 'Kontakt', href: '/kontakt' }]}
>
  <PageHero
    eyebrow="Kontakt"
    title="Powiedz, jakie auto szukasz"
    lead="Wypełnij formularz albo napisz na WhatsAppie. Na każde zapytanie odpowiadamy w ciągu 2 godzin roboczych konkretną wyceną — nie ogólnikami."
  />

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-[1.2fr_1fr] lg:px-8">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-ink-900">Formularz wyceny</h2>
        <p class="mt-2 text-ink-500">Im więcej szczegółów podasz, tym trafniejszą wycenę wyślemy.</p>
        <div class="mt-8">
          <ContactForm />
        </div>
      </div>

      <aside class="space-y-6">
        <div class="rounded-2xl bg-ink-900 p-6 text-white">
          <h2 class="text-xl font-extrabold">Szybki kontakt</h2>
          <ul class="mt-5 space-y-4 text-sm">
            <li>
              <p class="text-ink-300">Telefon</p>
              <a href={contact.phoneHref} class="text-lg font-bold text-accent-400">
                {contact.phone}
              </a>
            </li>
            <li>
              <p class="text-ink-300">E-mail</p>
              <a href={`mailto:${contact.email}`} class="font-semibold">{contact.email}</a>
            </li>
            <li>
              <p class="text-ink-300">Godziny pracy</p>
              <p class="font-semibold">{contact.hours}</p>
            </li>
          </ul>

          <div class="mt-6 grid gap-3">
            <a
              href={contact.whatsapp}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="rounded-lg bg-accent-500 px-4 py-3 text-center font-bold text-ink-900 hover:bg-accent-400"
            >
              Napisz na WhatsAppie
            </a>
            <a
              href={contact.whatsappGroup}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="rounded-lg border border-white/20 px-4 py-3 text-center font-bold hover:bg-white/10"
            >
              Grupa WhatsApp z ofertami
            </a>
          </div>
        </div>

        <div class="rounded-2xl border border-ink-100 p-6">
          <h2 class="text-xl font-extrabold text-ink-900">Biuro i plac</h2>
          <address class="mt-3 not-italic leading-relaxed text-ink-700">
            {site.legalName}<br />
            {address.street}<br />
            {address.postalCode} {address.city}
          </address>
          <a
            href={address.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex font-semibold text-accent-600 underline"
          >
            Otwórz w Mapach Google
          </a>

          {/* Mape wstawiamy dopiero po kliknieciu - iframe Google waży ~1 MB i psuje LCP. */}
          <div class="mt-4 overflow-hidden rounded-xl border border-ink-100">
            <div class="grid aspect-video place-items-center bg-ink-50 text-sm text-ink-500">
              TODO(klient): mapa Google (lazy iframe)
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-ink-100 p-6">
          <h2 class="text-xl font-extrabold text-ink-900">Social media</h2>
          <p class="mt-2 text-sm text-ink-500">
            Nowe auta z aukcji i relacje z warsztatu publikujemy codziennie.
          </p>
          <ul class="mt-4 grid grid-cols-2 gap-3 text-sm">
            {
              social.map((s) => (
                <li>
                  <a
                    href={s.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block rounded-lg bg-ink-50 px-4 py-3 font-semibold text-ink-700 hover:bg-ink-100"
                  >
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
