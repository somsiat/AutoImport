---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Nie znaleziono strony - AutoImport USA" description="Ta strona nie istnieje.">
	<section class="max-w-3xl mx-auto px-4 py-24 text-center">
		<p class="text-sm font-semibold uppercase tracking-wider text-blue-600">404</p>
		<h1 class="mt-3 text-3xl font-bold text-slate-900">Nie znaleźliśmy tej strony</h1>
		<p class="mt-4 text-slate-600">Sprawdź adres albo wróć na stronę główną.</p>
		<a href="/" class="mt-8 inline-block rounded-lg bg-blue-600 px-6 py-3 font-semibold text-white hover:bg-blue-700">
			Strona główna
		</a>
	</section>
</BaseLayout>
