---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Faq from '~/components/Faq.astro';
import CtaBanner from '~/components/CtaBanner.astro';
import { faqSchema } from '~/lib/schema';

const costs = [
  {
    item: 'Cena auta na aukcji',
    amount: 'zależna od modelu',
    note: 'Kwota licytacji plus opłaty aukcyjne Copart/IAAI (zwykle 500–900 USD).',
  },
  {
    item: 'Transport lądowy w USA',
    amount: '300–800 USD',
    note: 'Laweta z placu aukcyjnego do portu. Zależy od odległości.',
  },
  {
    item: 'Fracht morski',
    amount: '1 200–2 000 USD',
    note: 'Kontener współdzielony lub RoRo do Bremerhaven, Rotterdamu albo Gdyni.',
  },
  {
    item: 'Cło',
    amount: '10%',
    note: 'Liczone od wartości auta powiększonej o koszt transportu do portu UE.',
  },
  {
    item: 'Akcyza',
    amount: '3,1% lub 18,6%',
    note: 'Stawka 3,1% dla silników do 2.0, 18,6% powyżej 2.0. Hybrydy i elektryki mają zwolnienia.',
  },
  {
    item: 'VAT',
    amount: '23%',
    note: 'Od wartości auta wraz z cłem i transportem. Firmy na VAT mogą go odliczyć.',
  },
  {
    item: 'Odprawa, tłumaczenia, przegląd',
    amount: '1 500–2 500 zł',
    note: 'Agencja celna, tłumaczenia przysięgłe, badanie techniczne, tablice.',
  },
  {
    item: 'Naprawa',
    amount: 'od 5 000 zł',
    note: 'Zależy od zakresu szkody. Wyceniamy przed licytacją na podstawie zdjęć.',
  },
];

const costFaq = [
  {
    q: 'Od jakiej kwoty liczone jest cło i VAT przy imporcie auta z USA?',
    a: 'Podstawą jest cena zakupu auta powiększona o koszt transportu do granicy Unii Europejskiej. Do tej sumy dolicza się cło 10%, następnie akcyzę, a VAT 23% liczy się od wartości auta razem z cłem i akcyzą. Dlatego kolejność naliczania ma znaczenie i całość wychodzi wyżej niż proste zsumowanie procentów.',
  },
  {
    q: 'Czy akcyza za samochód z USA jest zawsze taka sama?',
    a: 'Nie. Dla silników o pojemności do 2000 cm³ stawka wynosi 3,1%, powyżej 2000 cm³ rośnie do 18,6%. Samochody elektryczne oraz hybrydy plug-in korzystają ze zwolnień lub stawek obniżonych, co przy Tesli daje realną oszczędność.',
  },
  {
    q: 'Czy firma może odliczyć VAT od auta sprowadzonego z USA?',
    a: 'Tak. Przy zakupie na firmę VAT zapłacony przy odprawie celnej podlega odliczeniu na zasadach ogólnych — 50% przy użytku mieszanym, 100% przy pełnym użytku firmowym z prowadzoną ewidencją przebiegu.',
  },
  {
    q: 'Ile realnie kosztuje sprowadzenie auta za 20 000 USD?',
    a: 'Przy kursie 4,00 zł i silniku powyżej 2.0 koszty importu (transport, cło, akcyza, VAT, odprawa) wynoszą zwykle 45–55 tysięcy złotych ponad cenę auta. Do tego dochodzi naprawa i nasza prowizja. Pełną kalkulację dla konkretnego egzemplarza przygotowujemy przed licytacją.',
  },
];
---

<BaseLayout
  title="Koszty sprowadzenia samochodu z USA"
  description="Ile kosztuje sprowadzenie auta z USA do Polski w 2026 roku: transport 1500–2800 USD, cło 10%, akcyza 3,1% lub 18,6%, VAT 23%. Kalkulator i pełna rozpiska kosztów."
  breadcrumbs={[{ name: 'Koszty sprowadzenia auta z USA', href: '/koszty-sprowadzenia-samochodu-z-usa' }]}
  schemas={[faqSchema(costFaq)]}
>
  <PageHero
    eyebrow="Koszty"
    title="Ile kosztuje sprowadzenie samochodu z USA?"
    lead="Poniżej wszystkie składniki kosztu — te oczywiste i te, o których zapominają kalkulatory konkurencji. Na końcu policzysz swój przypadek w kalkulatorze."
  />

  <section class="bg-white py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-ink-900">Składniki kosztu importu</h2>
      <div class="mt-8 overflow-x-auto">
        <table class="w-full border-collapse text-left text-sm">
          <thead>
            <tr class="border-b-2 border-ink-900">
              <th scope="col" class="py-3 pr-4 font-bold text-ink-900">Pozycja</th>
              <th scope="col" class="py-3 pr-4 font-bold text-ink-900">Kwota / stawka</th>
              <th scope="col" class="py-3 font-bold text-ink-900">Uwagi</th>
            </tr>
          </thead>
          <tbody>
            {
              costs.map((cost) => (
                <tr class="border-b border-ink-100 align-top">
                  <th scope="row" class="py-4 pr-4 font-semibold text-ink-900">{cost.item}</th>
                  <td class="py-4 pr-4 whitespace-nowrap font-bold text-accent-600">{cost.amount}</td>
                  <td class="py-4 text-ink-500">{cost.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="mt-8 rounded-2xl border-l-4 border-accent-500 bg-ink-50 p-6">
        <h3 class="font-bold text-ink-900">Najczęstszy błąd w kalkulacjach</h3>
        <p class="mt-2 leading-relaxed text-ink-700">
          Cło, akcyza i VAT nie sumują się liniowo — każdy kolejny podatek liczony jest od podstawy
          powiększonej o poprzedni. Przy silniku powyżej 2.0 realne obciążenie podatkowe sięga więc
          nie 33%, a około 40% wartości auta z transportem. Kalkulator poniżej liczy to w prawidłowej
          kolejności.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-ink-900 py-16 sm:py-24" id="kalkulator">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight text-white">Kalkulator kosztów importu</h2>
      <p class="mt-3 text-ink-300">
        Wynik jest szacunkowy i nie obejmuje naprawy ani naszej prowizji. Dokładną wycenę „pod klucz”
        przygotowujemy indywidualnie.
      </p>

      <form id="calc" class="mt-8 grid gap-6 rounded-2xl bg-white p-6 sm:p-8">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="calc-price" class="block text-sm font-semibold text-ink-700">
              Cena auta na aukcji (USD)
            </label>
            <input
              type="number"
              id="calc-price"
              value="20000"
              min="1000"
              step="500"
              class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500"
            />
          </div>
          <div>
            <label for="calc-rate" class="block text-sm font-semibold text-ink-700">
              Kurs USD/PLN
            </label>
            <input
              type="number"
              id="calc-rate"
              value="4.00"
              min="2"
              step="0.01"
              class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500"
            />
          </div>
          <div>
            <label for="calc-transport" class="block text-sm font-semibold text-ink-700">
              Transport łącznie (USD)
            </label>
            <input
              type="number"
              id="calc-transport"
              value="2200"
              min="0"
              step="100"
              class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500"
            />
          </div>
          <div>
            <label for="calc-excise" class="block text-sm font-semibold text-ink-700">
              Pojemność silnika
            </label>
            <select
              id="calc-excise"
              class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500"
            >
              <option value="18.6">powyżej 2.0 — akcyza 18,6%</option>
              <option value="3.1">do 2.0 — akcyza 3,1%</option>
              <option value="0">elektryk — akcyza 0%</option>
            </select>
          </div>
        </div>

        <output
          id="calc-output"
          for="calc-price calc-rate calc-transport calc-excise"
          class="grid gap-2 rounded-xl bg-ink-50 p-6 text-sm"
        >
        </output>
      </form>
    </div>
  </section>

  <Faq items={costFaq} title="Pytania o koszty i podatki" />
  <CtaBanner
    title="Policzymy dokładny koszt dla Twojego auta"
    body="Podaj model i budżet — wyślemy rozpisaną wycenę pod klucz, razem z kosztem naprawy."
  />
</BaseLayout>

<script>
  const form = document.getElementById('calc');
  const output = document.getElementById('calc-output');

  const val = (id: string) => Number((document.getElementById(id) as HTMLInputElement)?.value ?? 0);

  const pln = (value: number) =>
    value.toLocaleString('pl-PL', { style: 'currency', currency: 'PLN', maximumFractionDigits: 0 });

  function calculate() {
    const rate = val('calc-rate');
    const carPln = val('calc-price') * rate;
    const transportPln = val('calc-transport') * rate;
    const exciseRate = val('calc-excise') / 100;

    // Kolejnosc naliczania jest istotna: clo od wartosci celnej, akcyza od wartosci z clem,
    // VAT od wartosci z clem i akcyza.
    const customsBase = carPln + transportPln;
    const duty = customsBase * 0.1;
    const excise = (customsBase + duty) * exciseRate;
    const vat = (customsBase + duty + excise) * 0.23;
    const fees = 2000;
    const total = customsBase + duty + excise + vat + fees;

    const rows = [
      ['Auto', carPln],
      ['Transport', transportPln],
      ['Cło 10%', duty],
      ['Akcyza', excise],
      ['VAT 23%', vat],
      ['Odprawa, tłumaczenia, przegląd', fees],
    ] as const;

    if (!output) return;
    output.innerHTML =
      rows
        .map(
          ([label, value]) =>
            `<span class="flex justify-between gap-4"><span class="text-ink-500">${label}</span><span class="font-semibold">${pln(value)}</span></span>`,
        )
        .join('') +
      `<span class="mt-2 flex justify-between gap-4 border-t border-ink-300 pt-3 text-base"><span class="font-bold text-ink-900">Razem bez naprawy</span><span class="font-extrabold text-ink-900">${pln(total)}</span></span>`;
  }

  form?.addEventListener('input', calculate);
  calculate();
</script>
