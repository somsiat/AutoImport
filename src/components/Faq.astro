---
interface Props {
  items: readonly { q: string; a: string }[];
  title?: string;
  /** Tresc widoczna bez JS - details/summary daje rozwijanie natywnie. */
  intro?: string;
}

const { items, title = 'Najczęstsze pytania', intro } = Astro.props;
---

<section class="bg-white py-16 sm:py-24" id="faq">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">{title}</h2>
    {intro && <p class="mt-4 text-lg text-ink-500">{intro}</p>}

    <div class="mt-10 divide-y divide-ink-100 border-y border-ink-100">
      {
        items.map((item) => (
          <details class="group py-5">
            <summary
              class="flex cursor-pointer items-start justify-between gap-4 text-left text-lg font-semibold text-ink-900 marker:content-none"
            >
              <h3 class="text-lg font-semibold">{item.q}</h3>
              <span
                class="mt-1 shrink-0 text-accent-600 transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 5v14M5 12h14" stroke-linecap="round"></path>
                </svg>
              </span>
            </summary>
            <p class="mt-3 leading-relaxed text-ink-500">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
