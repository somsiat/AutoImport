---
import { contact } from '~/config/site';

/**
 * Strona jest statyczna, wiec formularz wysyla dane do zewnetrznego endpointu
 * (Formspree / Resend / wlasna funkcja serverless). Endpoint ustawiamy w .env:
 * PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
 * Bez JS formularz nadal dziala - przegladarka wysyla zwykly POST.
 */
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? 'https://formspree.io/f/PLACEHOLDER';

const budgets = [
  'do 60 000 zł',
  '60 000 – 100 000 zł',
  '100 000 – 150 000 zł',
  '150 000 – 250 000 zł',
  'powyżej 250 000 zł',
];
---

<form
  id="contact-form"
  action={endpoint}
  method="POST"
  class="grid gap-5 rounded-2xl border border-ink-100 bg-white p-6 shadow-sm sm:p-8"
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="block text-sm font-semibold text-ink-700">
        Imię i nazwisko <span class="text-accent-600">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/30"
      />
    </div>
    <div>
      <label for="phone" class="block text-sm font-semibold text-ink-700">
        Telefon <span class="text-accent-600">*</span>
      </label>
      <input
        type="tel"
        id="phone"
        name="phone"
        required
        autocomplete="tel"
        placeholder="+48 600 000 000"
        class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/30"
      />
    </div>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="email" class="block text-sm font-semibold text-ink-700">E-mail</label>
      <input
        type="email"
        id="email"
        name="email"
        autocomplete="email"
        class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/30"
      />
    </div>
    <div>
      <label for="budget" class="block text-sm font-semibold text-ink-700">Budżet „pod klucz”</label>
      <select
        id="budget"
        name="budget"
        class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/30"
      >
        <option value="">Wybierz zakres</option>
        {budgets.map((b) => <option value={b}>{b}</option>)}
      </select>
    </div>
  </div>

  <div>
    <label for="car" class="block text-sm font-semibold text-ink-700">
      Jakie auto Cię interesuje?
    </label>
    <input
      type="text"
      id="car"
      name="car"
      placeholder="np. Ford Mustang GT, rocznik 2018+"
      class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/30"
    />
  </div>

  <div>
    <label for="message" class="block text-sm font-semibold text-ink-700">Wiadomość</label>
    <textarea
      id="message"
      name="message"
      rows="4"
      class="mt-2 w-full rounded-lg border border-ink-100 bg-ink-50 px-4 py-3 text-ink-900 outline-none focus:border-accent-500 focus:ring-2 focus:ring-accent-500/30"
    ></textarea>
  </div>

  {/* Honeypot - boty wypelniaja ukryte pola, ludzie nie. */}
  <div class="hidden" aria-hidden="true">
    <label for="company">Firma</label>
    <input type="text" id="company" name="_gotcha" tabindex="-1" autocomplete="off" />
  </div>

  <input type="hidden" name="_subject" value="Zapytanie ze strony — import auta z USA" />

  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id="consent"
      name="consent"
      required
      value="tak"
      class="mt-1 h-5 w-5 shrink-0 rounded border-ink-300 text-accent-600 focus:ring-accent-500"
    />
    <label for="consent" class="text-sm leading-relaxed text-ink-500">
      Zgadzam się na kontakt telefoniczny i e-mailowy w sprawie mojego zapytania oraz na
      przetwarzanie danych zgodnie z <a href="/polityka-prywatnosci" class="font-semibold text-accent-600 underline">polityką prywatności</a>. <span class="text-accent-600">*</span>
    </label>
  </div>

  <button
    type="submit"
    class="rounded-lg bg-accent-500 px-6 py-4 text-base font-bold text-ink-900 transition-colors hover:bg-accent-400"
  >
    Wyślij zapytanie — odpowiadamy do 2 h
  </button>

  <p id="form-status" role="status" aria-live="polite" class="text-sm font-semibold"></p>

  <p class="text-center text-sm text-ink-500">
    Wolisz szybciej? Napisz na
    <a
      href={contact.whatsapp}
      target="_blank"
      rel="noopener noreferrer nofollow"
      class="font-semibold text-accent-600 underline">WhatsAppie</a
    >
    lub zadzwoń <a href={contact.phoneHref} class="font-semibold text-accent-600 underline">{contact.phone}</a>.
  </p>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (form.action.includes('PLACEHOLDER')) {
      if (status) {
        status.textContent = 'Formularz nie jest jeszcze podłączony (ustaw PUBLIC_FORM_ENDPOINT).';
        status.className = 'text-sm font-semibold text-red-600';
      }
      return;
    }

    const button = form.querySelector('button[type="submit"]');
    button?.setAttribute('disabled', 'true');
    if (status) {
      status.textContent = 'Wysyłamy…';
      status.className = 'text-sm font-semibold text-ink-500';
    }

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      form.reset();
      if (status) {
        status.textContent = 'Dziękujemy! Odezwiemy się najpóźniej w ciągu 2 godzin roboczych.';
        status.className = 'text-sm font-semibold text-green-700';
      }
    } catch {
      if (status) {
        status.textContent = 'Nie udało się wysłać. Zadzwoń lub napisz na WhatsAppie.';
        status.className = 'text-sm font-semibold text-red-600';
      }
    } finally {
      button?.removeAttribute('disabled');
    }
  });
</script>
