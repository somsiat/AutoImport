---
import { site, contact, address, social, nav } from '~/config/site';

const year = new Date().getFullYear();

const seoLinks = [
  { label: 'Import samochodów z USA — Warszawa', href: '/import-samochodow-z-usa-warszawa' },
  { label: 'Sprowadzanie samochodów z Kanady', href: '/sprowadzanie-samochodow-z-kanady' },
  { label: 'Samochody z aukcji Copart', href: '/samochody-z-copart' },
  { label: 'Koszty sprowadzenia auta z USA', href: '/koszty-sprowadzenia-samochodu-z-usa' },
];
---

<footer class="border-t border-white/10 bg-ink-900 text-ink-300">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 lg:grid-cols-4 lg:px-8">
    <div>
      <p class="text-lg font-extrabold text-white">
        Auto<span class="text-accent-400">Import</span> USA
      </p>
      <p class="mt-3 text-sm leading-relaxed">{site.description}</p>
      <div class="mt-5 flex gap-3">
        {
          social.map((s) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="grid h-9 w-9 place-items-center rounded-lg border border-white/15 text-xs font-bold text-white transition-colors hover:border-accent-500 hover:text-accent-400"
              aria-label={s.name}
            >
              {s.name.slice(0, 2)}
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <p class="text-sm font-bold uppercase tracking-wider text-white">Serwis</p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="hover:text-accent-400">{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-bold uppercase tracking-wider text-white">Popularne tematy</p>
      <ul class="mt-4 space-y-2 text-sm">
        {
          seoLinks.map((item) => (
            <li>
              <a href={item.href} class="hover:text-accent-400">{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="text-sm font-bold uppercase tracking-wider text-white">Kontakt</p>
      <address class="mt-4 space-y-2 text-sm not-italic">
        <p>{site.legalName}</p>
        <p>{address.street}<br />{address.postalCode} {address.city}</p>
        <p>
          <a href={contact.phoneHref} class="font-semibold text-white hover:text-accent-400">
            {contact.phone}
          </a>
        </p>
        <p>
          <a href={`mailto:${contact.email}`} class="hover:text-accent-400">{contact.email}</a>
        </p>
        <p class="text-ink-500">{contact.hours}</p>
      </address>
      <a
        href={contact.whatsappGroup}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="mt-4 inline-flex rounded-lg border border-accent-500/40 px-3 py-2 text-sm font-semibold text-accent-400 hover:bg-accent-500/10"
      >
        Grupa WhatsApp z ofertami
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-xs sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8"
    >
      <p>© {year} {site.legalName}. NIP {site.vatId}. Wszelkie prawa zastrzeżone.</p>
      <div class="flex gap-4">
        <a href="/polityka-prywatnosci" class="hover:text-accent-400">Polityka prywatności</a>
        <a href="/kontakt" class="hover:text-accent-400">Kontakt</a>
      </div>
    </div>
  </div>
</footer>
