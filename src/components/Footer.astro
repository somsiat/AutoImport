---
import { site, whatsappHref } from '../data/site.js';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 bg-white">
	<div class="max-w-5xl mx-auto grid gap-10 px-4 py-12 md:grid-cols-3">
		<div>
			<p class="text-lg font-bold text-blue-600">
				AutoImport <span class="text-slate-900">USA</span>
			</p>
			<p class="mt-3 text-sm leading-relaxed text-slate-600">{site.description}</p>
		</div>

		<div>
			<p class="text-sm font-semibold uppercase tracking-wider text-slate-900">Serwis</p>
			<ul class="mt-4 space-y-2 text-sm">
				<li><a href="/" class="text-slate-600 hover:text-blue-600">Strona główna</a></li>
				{
					site.nav.map((item) => (
						<li>
							<a href={item.href} class="text-slate-600 hover:text-blue-600">
								{item.label}
							</a>
						</li>
					))
				}
				<li>
					<a href="/polityka-prywatnosci" class="text-slate-600 hover:text-blue-600">
						Polityka prywatności
					</a>
				</li>
			</ul>
		</div>

		<div>
			<p class="text-sm font-semibold uppercase tracking-wider text-slate-900">Kontakt</p>
			<address class="mt-4 space-y-2 text-sm not-italic text-slate-600">
				<p>{site.address}</p>
				<p>
					<a href={site.phoneHref} class="font-semibold text-slate-900 hover:text-blue-600">
						{site.phone}
					</a>
				</p>
				<p>
					<a href={`mailto:${site.email}`} class="hover:text-blue-600">{site.email}</a>
				</p>
				<p>{site.hours}</p>
			</address>
			<a
				href={whatsappHref()}
				target="_blank"
				rel="noopener noreferrer"
				class="mt-4 inline-flex rounded-lg bg-green-500 px-4 py-2 text-sm font-semibold text-white hover:bg-green-600"
			>
				Napisz na WhatsApp
			</a>
		</div>
	</div>

	<div class="border-t border-slate-200">
		<div class="max-w-5xl mx-auto flex flex-col gap-2 px-4 py-6 text-xs text-slate-500 sm:flex-row sm:justify-between">
			<p>© {year} {site.legalName}. Wszelkie prawa zastrzeżone.</p>
			<a href="/polityka-prywatnosci" class="hover:text-blue-600">Polityka prywatności</a>
		</div>
	</div>
</footer>
