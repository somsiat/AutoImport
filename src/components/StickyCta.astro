---
import { contact } from '~/config/site';
---

{/* Na mobile to glowna sciezka konwersji - klienci wybieraja czat/telefon zamiast formularza. */}
<div
  class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-2 gap-2 border-t border-white/10 bg-ink-900/95 p-3 backdrop-blur lg:hidden"
>
  <a
    href={contact.phoneHref}
    class="flex items-center justify-center gap-2 rounded-lg border border-white/20 py-3 text-sm font-bold text-white"
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M6.6 10.8c1.4 2.8 3.8 5.2 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.4.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.3.6 3.4.1.4 0 .8-.2 1l-2.1 2.4z"
      ></path>
    </svg>
    Zadzwoń
  </a>
  <a
    href={contact.whatsapp}
    target="_blank"
    rel="noopener noreferrer nofollow"
    class="flex items-center justify-center gap-2 rounded-lg bg-accent-500 py-3 text-sm font-bold text-ink-900"
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M12 2a10 10 0 0 0-8.7 15L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 2a8 8 0 1 1-4.2 14.8l-.4-.2-2.6.7.7-2.5-.2-.4A8 8 0 0 1 12 4zm-3 4.3c-.2 0-.5.1-.7.3-.3.3-.7.8-.7 1.7 0 .9.6 1.8 1 2.3.5.6 1.7 2 3.6 2.7 1.5.6 2 .5 2.4.5.5 0 1.3-.5 1.5-1 .2-.5.2-.9.1-1l-.2-.2-1.4-.7c-.2-.1-.4 0-.5.1l-.6.7c-.1.2-.3.2-.5.1-.4-.2-1.2-.5-1.8-1.1-.5-.5-.8-1-1-1.4-.1-.2 0-.3.1-.4l.4-.5c.1-.2.1-.3 0-.5l-.6-1.4c-.1-.2-.2-.3-.4-.3H9z"
      ></path>
    </svg>
    WhatsApp
  </a>
</div>

{/* Pasek zaslania stopke, wiec rezerwujemy pod niego miejsce. */}
<div class="h-20 lg:hidden" aria-hidden="true"></div>
