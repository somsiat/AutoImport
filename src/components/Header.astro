---
import { nav, contact, site } from '~/config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/'));
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink-900/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-white" aria-label={`${site.name} — strona główna`}>
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-accent-500 font-extrabold text-ink-900">
        AI
      </span>
      <span class="text-lg font-extrabold tracking-tight">
        Auto<span class="text-accent-400">Import</span> USA
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Menu główne">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-white/10 text-white'
                : 'text-ink-300 hover:bg-white/5 hover:text-white',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a
        href={contact.phoneHref}
        class="text-sm font-semibold text-white transition-colors hover:text-accent-400"
      >
        {contact.phone}
      </a>
      <a
        href={contact.whatsapp}
        rel="noopener noreferrer nofollow"
        target="_blank"
        class="rounded-lg bg-accent-500 px-4 py-2 text-sm font-bold text-ink-900 transition-colors hover:bg-accent-400"
      >
        Wyceń auto
      </a>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="grid h-10 w-10 place-items-center rounded-lg border border-white/15 text-white lg:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Otwórz menu"
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" hidden class="border-t border-white/10 bg-ink-900 lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-4 py-3 sm:px-6" aria-label="Menu mobilne">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="rounded-md px-3 py-3 text-base font-medium text-ink-100 hover:bg-white/5"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={contact.phoneHref}
        class="mt-2 rounded-lg bg-accent-500 px-3 py-3 text-center text-base font-bold text-ink-900"
      >
        Zadzwoń: {contact.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Otwórz menu' : 'Zamknij menu');
    if (menu) menu.hidden = open;
  });
</script>
