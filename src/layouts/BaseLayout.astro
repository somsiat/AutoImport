---
import BaseHead from '~/components/BaseHead.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import StickyCta from '~/components/StickyCta.astro';
import { localBusinessSchema, breadcrumbSchema } from '~/lib/schema';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schemas?: unknown[];
  /** Sciezka okruszkow bez strony glownej - ta jest dodawana automatycznie. */
  breadcrumbs?: { name: string; href: string }[];
}

const { title, description, image, noindex, schemas = [], breadcrumbs = [] } = Astro.props;

const pageSchemas = [
  localBusinessSchema(),
  ...(breadcrumbs.length
    ? [breadcrumbSchema([{ name: 'Strona główna', href: '/' }, ...breadcrumbs])]
    : []),
  ...schemas,
];
---

<!doctype html>
<html lang="pl" class="bg-ink-900">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      schemas={pageSchemas}
    />
  </head>
  <body class="flex min-h-screen flex-col bg-white font-sans text-ink-800">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded focus:bg-accent-500 focus:px-4 focus:py-2 focus:font-semibold"
    >
      Przejdź do treści
    </a>

    <Header />

    {
      breadcrumbs.length > 0 && (
        <nav aria-label="Okruszki" class="border-b border-ink-100 bg-ink-50">
          <ol class="mx-auto flex max-w-7xl flex-wrap gap-2 px-4 py-3 text-xs text-ink-500 sm:px-6 lg:px-8">
            <li><a href="/" class="hover:text-accent-600">Strona główna</a></li>
            {breadcrumbs.map((crumb, i) => (
              <li class="flex gap-2">
                <span aria-hidden="true">/</span>
                {i === breadcrumbs.length - 1 ? (
                  <span class="font-medium text-ink-700">{crumb.name}</span>
                ) : (
                  <a href={crumb.href} class="hover:text-accent-600">{crumb.name}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <main id="main" class="flex-1">
      <slot />
    </main>

    <StickyCta />
    <Footer />
  </body>
</html>
